# Google Gemini API Key (Required for AI Analysis)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# MongoDB Connection (Required for Database)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app_name>
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=chalktalk_ai

# Optional: Port configuration (default is 8000)
# PORT=8000
